{
  "name": "atlas-sonoro-aves-chile",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "eslint web/js tests",
    "test": "node --test tests/unit/*.test.mjs",
    "test:browser": "node tests/browser-regression.cjs --baseline 57b6dc8",
    "test:python": "python3 tests/python-invariance.py",
    "format:check": "prettier --check \"web/js/**/*.js\" \"tests/**/*.mjs\" tests/browser-regression.cjs eslint.config.js package.json",
    "build:metrics": "node scripts/build-metrics.mjs",
    "test:metrics": "node tests/metrics-browser.cjs"
  },
  "devDependencies": {
    "d3": "7.9.0",
    "eslint": "10.12.0",
    "pixelmatch": "7.1.0",
    "playwright": "1.56.1",
    "pngjs": "7.0.0",
    "prettier": "3.6.2"
  }
}
